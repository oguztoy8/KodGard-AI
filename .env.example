# Servislerin host tarafında bağlanacağı arayüz (yalnızca yerel erişim için 127.0.0.1)
# Not: /enqueue endpoint'inde kimlik doğrulaması yoktur; servis varsayılan olarak yalnızca 127.0.0.1'e bağlıdır.
KODGARD_BIND=127.0.0.1

# Host portları
FRONTEND_PORT=5173
API_PORT=8000
# DB_PORT yalnızca host modu içindir (127.0.0.1'e bağlı)
DB_PORT=5432

# PostgreSQL ayarları
POSTGRES_USER=kodgard
POSTGRES_PASSWORD=kodgard
POSTGRES_DB=kodgard

# Host modu için veritabanı ve proje dizini ayarları
DATABASE_URL=postgresql://kodgard:kodgard@localhost:5432/kodgard
KODGARD_HOME=/home/oguz/KodGard-AI

# Anthropic API anahtarı (buraya kendi anahtarınızı yazın, dosyayı commit etmeyin)
ANTHROPIC_API_KEY=

# İncelenecek git repolarının bulunduğu üst dizin (docker compose için zorunludur)
# Örnek: REPOS_HOST_DIR=/home/kullanici/projeler
REPOS_HOST_DIR=

# Model ve RAG yapılandırması
REVIEW_MODEL=claude-sonnet-5-5
ASSISTANT_MODEL=claude-haiku-5-5
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Opsiyonel HuggingFace token (gerekmez)
HF_TOKEN=
